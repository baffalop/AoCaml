(rule
 (target all.ml)
 (deps
  (:problem_files
   (glob_files_rec "problem*{[!.]??.ml,.re}"))
  (:generator generator/gen.exe))
 (action
  (run %{generator} %{target} %{problem_files})))

(include_subdirs unqualified)

(library
 (name problems)
 (preprocess (pps ppx_deriving.show))
 (libraries problem import angstrom)
 )
